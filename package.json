{
  "name": "my-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "serve": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "cf:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "pagefind": "^1.4.0",
    "wrangler": "^4.42.0",
    "yargs-parser": "^21.1.1"
  },
  "comments": {
    "yargs-parser": "Astro CLI 会直接 import 它；个别 npm/pnpm 版本在孤立链接布局下没把它链到 node_modules 根目录，显式声明一次最稳，无副作用。"
  }
}
