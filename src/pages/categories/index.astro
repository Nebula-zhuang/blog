---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectCategories, getSortedPosts } from '../../utils/posts';

const posts = await getSortedPosts();
const categories = collectCategories(posts);
---

<BaseLayout title="分类" description="按分类浏览全部文章。">
  <header class="page-head reveal">
    <p class="eyebrow">CATEGORIES</p>
    <h1>分类</h1>
    <p>共 {categories.length} 个分类 · {posts.length} 篇文章</p>
  </header>

  {
    categories.length > 0 ? (
      <div class="cat-list">
        {categories.map(({ category, count }) => (
          <a class="cat-row reveal" href={`/categories/${encodeURIComponent(category)}/`}>
            <span class="cat-name">{category}</span>
            <span class="cat-count">{count} 篇</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty reveal">
        <p class="muted">还没有分类。</p>
        <p class="dim">
          把文章放进 <code>src/content/blog/&lt;分类名&gt;/</code> 目录，分类就会自动出现。
          例如 <code>src/content/blog/随笔/第一篇.md</code> 就是分类「随笔」。
        </p>
      </div>
    )
  }
</BaseLayout>

<style>
  .cat-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .cat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    transition: padding 0.16s ease, color 0.16s ease;
  }

  .cat-row:hover {
    padding-left: 10px;
    color: var(--accent);
  }

  .cat-name {
    font-size: 1rem;
    font-weight: 600;
  }

  .cat-count {
    font-size: 0.84rem;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    padding: 30px 0;
    font-size: 0.94rem;
  }

  .empty p {
    margin: 0 0 10px;
  }

  .empty code {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    font-size: 0.88em;
  }
</style>