---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { collectCategories, getSortedPosts, postCategory } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const categories = collectCategories(posts);

  return categories.map(({ category }) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((post) => postCategory(post) === category),
    },
  }));
}

const { category, posts } = Astro.props as {
  category: string;
  posts: Awaited<ReturnType<typeof getSortedPosts>>;
};
---

<BaseLayout title={`分类：${category}`} description={`分类「${category}」下的全部文章，共 ${posts.length} 篇。`}>
  <header class="page-head reveal">
    <p class="eyebrow">CATEGORY</p>
    <h1>{category}</h1>
    <p>共 {posts.length} 篇文章</p>
  </header>

  <div class="post-list">
    {
      posts.map((post, i) => (
        <div class="reveal">
          <PostCard post={post} index={i} />
        </div>
      ))
    }
  </div>

  <p style="margin-top:30px">
    <a class="btn" href="/categories">← 全部分类</a>
  </p>
</BaseLayout>