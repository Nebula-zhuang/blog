---
import BaseLayout from '../layouts/BaseLayout.astro';
import { friends } from '../data/friends';
import { site } from '../config';

const initial = (name: string) => name.slice(0, 1);
---

<BaseLayout title="友情链接" description={`友情链接，共 ${friends.length} 个站点。`}>
  <header class="page-head reveal">
    <p class="eyebrow">FRIENDS</p>
    <h1>友情链接</h1>
    <p>共 {friends.length} 个站点 · 排序不分先后</p>
  </header>

  {
    friends.length > 0 ? (
      <div class="friend-grid">
        {friends.map((friend) => (
          <a class="friend-card reveal" href={friend.url} target="_blank" rel="noopener noreferrer">
            {friend.avatar ? (
              <img class="friend-avatar" src={friend.avatar} alt={friend.name} width="40" height="40" loading="lazy" />
            ) : (
              <span
                class="friend-avatar friend-initial"
                style={friend.color ? `background:${friend.color};color:#fff;border-color:transparent` : undefined}
              >
                {friend.initial ?? initial(friend.name)}
              </span>
            )}

            <span class="friend-body">
              <span class="friend-name">{friend.name}</span>
              {friend.desc && <span class="friend-desc">{friend.desc}</span>}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty reveal">
        <p class="muted">还没有添加友链。</p>
        <p class="dim">
          编辑 <code>src/data/friends.ts</code>，在数组里追加一项就会出现一张卡片。
        </p>
      </div>
    )
  }

  <section class="section apply reveal">
    <h2>想交换友链？</h2>
    <p class="muted">欢迎独立博客来换链接。把下面这段信息发到我的邮箱或评论区，我会尽快加上：</p>
    <pre><code>站点名：
地址：
一句话介绍：
头像地址（可选）：</code></pre>
    <p class="muted">要求不高：内容原创、能正常访问、别是采集站。</p>
  </section>
</BaseLayout>

<style>
  .friend-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }

  .friend-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .friend-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    flex: none;
  }

  .friend-initial {
    display: grid;
    place-items: center;
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .friend-name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .friend-desc {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .apply h2 {
    margin: 0 0 10px;
    font-size: 1.06rem;
  }

  .apply pre {
    margin: 14px 0;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    font-size: 0.84rem;
    line-height: 1.7;
    overflow-x: auto;
  }

  .empty {
    padding: 30px 0;
    font-size: 0.94rem;
  }

  .empty p {
    margin: 0 0 10px;
  }

  .empty code {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    font-size: 0.88em;
  }
</style>