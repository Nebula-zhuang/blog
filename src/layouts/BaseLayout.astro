---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { backgrounds, site } from '../config';
import { withBase } from '../utils/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import Splash from '../components/Splash.astro';
import { collectCategories, collectTags, getSortedPosts, postUrl } from '../utils/posts';

interface Props {
  title?: string;
  description?: string;
  /** 是否播放首页入场动画 */
  splash?: boolean;
  /** OG 分享图（默认用构建时生成的 /og.svg；放一张 public/og.png 可换成 PNG） */
  ogImage?: string;
  /** 文章页传 type=article */
  type?: 'website' | 'article';
  /** 结构化数据 */
  jsonLd?: Record<string, unknown>;
  /** 关掉右侧边栏（例如 404 页需要全宽） */
  showSidebar?: boolean;
}

const {
  title,
  description = site.description,
  splash = false,
  ogImage = '/og.svg',
  type = 'website',
  jsonLd,
  showSidebar = true,
} = Astro.props;

// 侧边栏显示的计数与最近更新
const allPosts = await getSortedPosts();
const sidebarStats = {
  posts: allPosts.length,
  categories: collectCategories(allPosts).length,
  tags: collectTags(allPosts).length,
};
const recentPosts = allPosts.slice(0, 5).map((post) => ({
  title: post.data.title,
  href: postUrl(post),
}));

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
// Astro.url.pathname 已经包含 base 前缀，这里用 origin + pathname 拼接，避免重复加前缀
const canonical = `${new URL(site.url).origin}${Astro.url.pathname}`;
const ogUrl = new URL(ogImage, site.url).href;

/* ---------- 背景层：把 config.ts 里的方案翻译成内联 CSS 变量 ---------- */
const bg = site.background;
const preset = bg.preset;
const [c1, c2 = c1, c3 = c1] = bg.customColors;
const gridColor = bg.gridColor;

const bgStyle = [
  `--bg-opacity:${bg.opacity}`,
  `--bg-blur:${bg.blur}px`,
  `--bg-speed:${Math.max(bg.speed, 1)}s`,
  `--bg-a:${c1}`,
  `--bg-b:${c2}`,
  `--bg-c:${c3}`,
  `--bg-grid-color:${gridColor}`,
]
  .join(';');

// 自定义方案：直接把颜色拼成渐变，不用预设的图
const customImage =
  preset === 'custom'
    ? [
        `radial-gradient(46vw 46vw at 16% 10%, ${c1}, transparent 70%)`,
        `radial-gradient(40vw 40vw at 84% 4%, ${c2}, transparent 70%)`,
        `radial-gradient(50vw 50vw at 70% 82%, ${c3}, transparent 72%)`,
      ].join(',')
    : null;

const bgLabel = backgrounds[preset]?.label ?? preset;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />

    <!-- 主题初始化必须内联在最前面，否则会闪一下。默认走白底，只有用户手动切过才记住 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          /* 隐私模式下保持默认浅色 */
        }
      })();
    </script>

    <!-- Open Graph / 社交分享 -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/avatar-180.png')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0a0a12" />

    <ClientRouter />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>

  <body>
    <!-- 背景层：方案与强度来自 src/config.ts，可用 ?bg=waves 之类的参数临时预览 -->
    <div
      id="bg-layer"
      data-preset={preset}
      data-anim={bg.speed > 0 ? '1' : '0'}
      data-label={bgLabel}
      aria-hidden="true"
      style={customImage
        ? `${bgStyle};--bg-custom:${customImage}`
        : bgStyle}
    >
    </div>

    {splash && <Splash />}
    <Header />
    <main id="main" class:list={['shell', { 'shell-single': !showSidebar }]}>
      <div class="content">
        <slot />
      </div>
      {showSidebar && <Sidebar stats={sidebarStats} recent={recentPosts} />}
    </main>
    <Footer />

    <!-- 回到顶部 -->
    <button id="to-top" class="to-top" type="button" aria-label="回到顶部">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V6" /><path d="m5 13 7-7 7 7" />
      </svg>
    </button>

    <style>
      .to-top {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 90;
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 99px;
        border: 1px solid var(--border-strong);
        background: color-mix(in srgb, var(--bg-soft) 80%, transparent);
        backdrop-filter: blur(10px);
        color: var(--text-soft);
        cursor: pointer;
        opacity: 0;
        transform: translateY(14px) scale(0.9);
        pointer-events: none;
        transition: opacity 0.3s ease, transform 0.3s ease, color 0.2s ease;
      }

      .to-top.is-in {
        opacity: 1;
        transform: none;
        pointer-events: auto;
      }

      .to-top:hover {
        color: var(--accent);
        border-color: var(--accent-border);
      }
    </style>

    <script>
      /* ============ 滚动进场动效 ============ */
      let revealObserver: IntersectionObserver | null = null;

      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        if (!items.length) return;

        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        revealObserver?.disconnect();
        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        items.forEach((el, i) => {
          if (!el.style.getPropertyValue('--reveal-delay')) {
            el.style.setProperty('--reveal-delay', `${Math.min(i, 6) * 65}ms`);
          }
          revealObserver!.observe(el);
        });
      }

      /* ============ 回到顶部 ============ */
      function initToTop() {
        const btn = document.getElementById('to-top');
        if (!btn || btn.dataset.ready === '1') return;
        btn.dataset.ready = '1';

        const sync = () => btn.classList.toggle('is-in', window.scrollY > 640);
        sync();
        window.addEventListener('scroll', sync, { passive: true });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      /* ============ 首页入场结束后播放内容动画 ============ */
      function initAfterSplash() {
        if (document.documentElement.dataset.splash !== 'done') return;
        document.body.classList.add('splash-finished');
        initReveal();
      }

      /* ============ 背景层：支持 ?bg=xxx 临时预览与 ?grain=1 颗粒感 ============ */
      function initBackground() {
        const layer = document.getElementById('bg-layer');
        if (!layer) return;

        const params = new URLSearchParams(location.search);
        const override = params.get('bg');
        if (override) {
          layer.dataset.preset = override;
          layer.dataset.anim = override === 'none' ? '0' : layer.dataset.anim || '1';
        }

        // ?grain=1 叠一层噪点质感（也可以直接在 config 里把 preset 换成 grain）
        const grain = params.get('grain');
        const wantGrain = grain === '1' || layer.dataset.preset === 'grain';
        document.body.classList.toggle('bg-grain', wantGrain);
      }

      /* ============ 点击处蹦出雪花（散开，不往下掉） ============ */
      function initSnow() {
        if (document.documentElement.dataset.snowReady === '1') return;
        document.documentElement.dataset.snowReady = '1';

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const glyphs = ['❄', '❅', '❆', '•'];
        let last = 0;

        window.addEventListener(
          'pointerdown',
          (e) => {
            const now = Date.now();
            if (now - last < 90) return;
            last = now;

            // 一小撮就够，围绕点击点散开
            const count = reduced ? 4 : 7 + Math.floor(Math.random() * 4);
            const baseAngle = Math.random() * Math.PI * 2;

            for (let i = 0; i < count; i++) {
              const flake = document.createElement('span');
              flake.className = 'snowflake';
              flake.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];

              const size = 9 + Math.random() * 6; // 9~15px
              const duration = (reduced ? 0.5 : 0.6) + Math.random() * 0.45; // 0.6~1.05s
              // 以点击点为中心向四周散开
              const angle = baseAngle + (i / count) * Math.PI * 2 + (Math.random() - 0.5) * 0.6;
              const distance = 26 + Math.random() * 34; // 散开 26~60px，就在手边

              flake.style.left = `${e.clientX}px`;
              flake.style.top = `${e.clientY}px`;
              flake.style.fontSize = `${size}px`;
              flake.style.animationDuration = `${duration}s`;
              flake.style.animationDelay = `${Math.random() * 0.08}s`;
              flake.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
              flake.style.setProperty('--dy', `${Math.sin(angle) * distance}px`);
              flake.style.setProperty('--rot', `${(Math.random() - 0.5) * 220}deg`);
              flake.style.setProperty('--dur', `${duration}s`);
              flake.style.opacity = String(0.6 + Math.random() * 0.4);

              document.body.appendChild(flake);
              window.setTimeout(() => flake.remove(), (duration + 0.4) * 1000);
            }
          },
          { passive: true }
        );
      }

      function boot() {
        initBackground();
        initReveal();
        initToTop();
        initAfterSplash();
        initSnow();
      }

      boot();
      document.addEventListener('astro:page-load', boot);
      window.addEventListener('splash:enter', () => {
        window.setTimeout(initReveal, 120);
      });
    </script>
  </body>
</html>
