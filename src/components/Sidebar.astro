---
import { site } from '../config';
import { friends } from '../data/friends';
import { withBase } from '../utils/url';

interface RecentItem {
  title: string;
  href: string;
}

interface Props {
  /** 文章数 / 分类数 / 标签数，显示在头像下面；不传就不显示这一行 */
  stats?: { posts?: number; categories?: number; tags?: number };
  /** 最近更新 */
  recent?: RecentItem[];
}

const { stats, recent = [] } = Astro.props;
const profile = site.sidebar;
// 侧边栏只显示前 5 个友链，全部在 /friends 页
const sideFriends = friends.slice(0, 5);

const icons: Record<string, string> = {
  github:
    '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.4 9.4 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />',
  mail: '<path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-11Z" /><path d="m4 7 8 5.5L20 7" />',
  rss: '<path d="M5 19a1.5 1.5 0 1 0 0-.01M5 12a7 7 0 0 1 7 7M5 5a14 14 0 0 1 14 14" />',
  location:
    '<path d="M12 21s-6.5-5.6-6.5-10.2A6.5 6.5 0 0 1 12 4.3a6.5 6.5 0 0 1 6.5 6.5C18.5 15.4 12 21 12 21Z" /><circle cx="12" cy="10.8" r="2.3" />',
};
---

<aside class="sidebar" aria-label="侧边栏">
  <!-- 头像 / 姓名 / 社交 -->
  <div class="side-card profile">
    <!-- 点一下头像会翻过来（搞怪） -->
    <button
      id="avatar-flip"
      class="avatar-flip"
      type="button"
      aria-label="点一下头像"
      title="点一下试试"
    >
      <span class="avatar-flip-inner">
        <span class="avatar-face avatar-front">
          {
            profile.avatar ? (
              <img
                src={withBase(profile.avatar)}
                alt={profile.name}
                width="76"
                height="76"
                loading="lazy"
              />
            ) : (
              <span class="avatar-fallback" aria-hidden="true">
                {profile.name.slice(0, 1)}
              </span>
            )
          }
        </span>
        <span class="avatar-face avatar-back" aria-hidden="true">
          <span class="avatar-kaomoji">(⌒‿⌒)</span>
        </span>
      </span>
    </button>

    <p class="profile-name">{profile.name}</p>
    {profile.motto && <p class="profile-motto">{profile.motto}</p>}
    {profile.latin && <p class="profile-latin">{profile.latin}</p>}
    {profile.bio && <p class="profile-bio">{profile.bio}</p>}

    {
      profile.location && (
        <p class="profile-location">
          <svg
            viewBox="0 0 24 24"
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icons.location}
          />
          {profile.location}
        </p>
      )
    }

    {
      stats && (
        <div class="profile-stats">
          <span>
            <b>{stats.posts ?? 0}</b>文章
          </span>
          <span>
            <b>{stats.categories ?? 0}</b>分类
          </span>
          <span>
            <b>{stats.tags ?? 0}</b>标签
          </span>
        </div>
      )
    }

    <div class="social-row">
      {
        site.social.map((item) => (
          <a
            href={withBase(item.href)}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={item.label}
            title={item.label}
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[item.icon] ?? icons.rss}
            />
          </a>
        ))
      }
    </div>
  </div>

  <!-- 最近更新 -->
  {
    recent.length > 0 && (
      <div class="side-card">
        <p class="side-title">最近更新</p>
        <div class="side-recent">
          {recent.map((item) => (
            <a href={item.href}>{item.title}</a>
          ))}
        </div>
      </div>
    )
  }

  <!-- 友情链接（数据在 src/data/friends.ts，没数据就不显示这张卡） -->
  {
    sideFriends.length > 0 && (
      <div class="side-card">
        <p class="side-title">友情链接</p>
        <div class="side-friends">
          {sideFriends.map((friend) => (
            <a href={friend.url} target="_blank" rel="noopener noreferrer">
              <span
                class="friend-dot"
                style={friend.color
                  ? `background:${friend.color};color:#fff;border-color:transparent`
                  : undefined}
              >
                {friend.initial ?? friend.name.slice(0, 1)}
              </span>
              <span>{friend.name}</span>
            </a>
          ))}
        </div>
        <a class="side-more" href={withBase('/friends')}>全部友链 →</a>
      </div>
    )
  }
</aside>

<style>
  /* ---------- 头像翻转 ---------- */
  .avatar-flip {
    display: block;
    width: 76px;
    height: 76px;
    margin-inline: auto;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    perspective: 600px;
    -webkit-tap-highlight-color: transparent;
  }

  .avatar-flip-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.3, 1.3, 0.4, 1);
  }

  .avatar-flip.is-flipped .avatar-flip-inner {
    transform: rotateY(180deg);
  }

  .avatar-face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .avatar-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-back {
    transform: rotateY(180deg);
    background: linear-gradient(140deg, #fde68a, #fca5a5 55%, #c4b5fd);
    border-color: transparent;
  }

  .avatar-kaomoji {
    font-size: 0.85rem;
    font-weight: 700;
    color: #4c1d95;
    letter-spacing: -0.02em;
  }

  .avatar-flip:hover .avatar-flip-inner {
    transform: rotateY(12deg) scale(1.03);
  }

  .avatar-flip.is-flipped:hover .avatar-flip-inner {
    transform: rotateY(180deg) scale(1.03);
  }
</style>

<script>
  function initAvatarFlip() {
    const btn = document.getElementById('avatar-flip');
    if (!btn || btn.dataset.ready === '1') return;
    btn.dataset.ready = '1';

    btn.addEventListener('click', () => {
      btn.classList.toggle('is-flipped');
    });
  }

  initAvatarFlip();
  document.addEventListener('astro:page-load', initAvatarFlip);
</script>
