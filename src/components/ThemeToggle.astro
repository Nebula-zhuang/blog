---
// 亮/暗主题切换按钮。真正的"无闪烁"初始化脚本在 BaseLayout 的 <head> 里内联执行。
---

<button id="theme-toggle" class="theme-btn" type="button" aria-label="切换亮色/暗色主题" title="切换主题">
  <svg class="ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6" />
  </svg>
  <svg class="ico-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.5 14.4A8.6 8.6 0 0 1 9.6 3.5a8.8 8.8 0 1 0 10.9 10.9Z" />
  </svg>
</button>

<style>
  .theme-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 99px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--text-soft);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .theme-btn:hover {
    color: var(--accent);
    border-color: var(--accent-border);
  }

  .ico-sun,
  .ico-moon {
    grid-area: 1 / 1;
    transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* 暗色主题下显示太阳（点它切回亮色） */
  :global(html[data-theme='dark']) .ico-sun {
    opacity: 1;
    transform: none;
  }

  :global(html[data-theme='dark']) .ico-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  /* 亮色主题下显示月亮 */
  :global(html:not([data-theme='dark'])) .ico-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  :global(html:not([data-theme='dark'])) .ico-moon {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  function initTheme() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.ready === '1') return;
    btn.dataset.ready = '1';

    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';

      // 切换主题时不要触发整页过渡动画
      root.classList.add('theme-switching');
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* 隐私模式忽略 */
      }
      window.setTimeout(() => root.classList.remove('theme-switching'), 60);
    });
  }

  initTheme();
  document.addEventListener('astro:page-load', initTheme);
</script>
