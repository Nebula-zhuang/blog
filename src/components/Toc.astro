---
// 文章目录：从 Markdown 的 h2/h3 生成，滚动时高亮当前章节
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 2 && (
    <aside class="toc" aria-label="文章目录" data-pagefind-ignore>
      <p class="toc-title">目录</p>
      <ul>
        {items.map((h) => (
          <li class:list={[`depth-${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .toc {
    position: sticky;
    top: 82px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    font-size: 0.84rem;
    border-left: 1px solid var(--border);
    padding-left: 14px;
  }

  .toc-title {
    margin: 0 0 10px;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    font-weight: 600;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc li {
    margin-bottom: 5px;
  }

  .toc li.depth-3 {
    padding-left: 10px;
    font-size: 0.94em;
  }

  .toc a {
    display: block;
    color: var(--text-dim);
    line-height: 1.5;
    transition: color 0.16s ease;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a.is-active {
    color: var(--accent);
  }
</style>

<script>
  function initToc() {
    const toc = document.querySelector<HTMLElement>('.toc');
    if (!toc || toc.dataset.ready === '1') return;
    toc.dataset.ready = '1';

    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => Boolean(el));

    if (!targets.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((l) => l.classList.toggle('is-active', l.hash === `#${entry.target.id}`));
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    targets.forEach((t) => observer.observe(t));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
