---
import { site } from '../config';
import { withBase } from '../utils/url';

/**
 * 入场加载页
 *
 * variant 来自 src/config.ts 的 site.splash.variant：
 *   'video'      全屏动画视频当背景板 + 流式输出文案（默认）
 *   'minimal'    细字姓名 + 细线进度 + 下拉进入
 *   'typewriter' 打字机问候 + 姓名逐字浮现
 *   'none'       不要这一屏
 *
 * 流式输出文案与速度在 config.ts 的 splash.streamText / streamSpeed。
 * 想彻底改样子：改本文件 <style> 里的 .splash-* 规则。
 */
const {
  variant,
  sub,
  enterText,
  video,
  videoLoop,
  videoScale,
  videoFit,
  videoOverlay,
  streamText,
  streamSpeed,
  streamCursor,
} = site.splash;
const isVideo = variant === 'video';
// 全屏当背景板时文字压在画面中央，卡片模式则居中排列
const isFullBleed = isVideo && videoFit !== 'card';
---

{
  variant !== 'none' && (
    <div
      id="splash"
      class="splash"
      data-variant={variant}
      data-fit={isVideo ? videoFit : undefined}
      data-stream={streamText}
      data-speed={streamSpeed}
      data-cursor={streamCursor ? '1' : '0'}
      data-sub={sub}
      style={isVideo ? `--video-scale:${videoScale};--video-overlay:${videoOverlay}` : undefined}
      role="region"
      aria-label="欢迎页"
    >
      {isVideo && (
        <div class="splash-stage">
          <div class="splash-video-wrap">
            <video
              id="splash-video"
              class="splash-video"
              src={withBase(video)}
              autoplay
              muted
              playsinline
              preload="auto"
              loop={videoLoop}
              disablepictureinpicture
            />
            {isFullBleed && <div class="splash-scrim" aria-hidden="true" />}
          </div>

          <div class="splash-caption">
            <p class="splash-stream" id="splash-stream" aria-live="polite">
              <span class="splash-stream-text" id="splash-stream-text" />
              <span class="stream-caret" id="splash-caret" aria-hidden="true" />
            </p>
            {sub && <p class="splash-sub" id="splash-sub" />}
          </div>
        </div>
      )}

      {!isVideo && (
        <div class="splash-inner">
          {variant === 'typewriter' && (
            <p class="splash-greet">
              <span id="splash-typed" />
              <span class="caret" aria-hidden="true" />
            </p>
          )}

          <h1 class="splash-name" id="splash-name">
            {variant === 'minimal' ? streamText : ''}
          </h1>

          {sub && <p class="splash-sub" id="splash-sub" />}
        </div>
      )}

      <button class="splash-enter" id="splash-enter" type="button" aria-label="进入主页">
        <span class="splash-enter-text">{enterText}</span>
        <span class="splash-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v13" />
            <path d="m6 12 6 6 6-6" />
          </svg>
        </span>
        <span class="splash-bar" aria-hidden="true">
          <i id="splash-progress" />
        </span>
      </button>
    </div>
  )
}

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 200;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #000; /* 全屏背景板模式下，任何缝隙都是黑的，不会露白 */
    overflow: hidden;
    cursor: pointer;
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .splash.is-skipped {
    display: none;
  }

  .splash.is-leaving {
    opacity: 0;
    transform: translateY(-6%);
    pointer-events: none;
  }

  .splash-inner {
    text-align: center;
    padding: 0 24px;
    max-width: 620px;
  }

  /* ---- video：动画视频 ---- */
  .splash[data-variant='video'] .splash-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 4vh, 40px);
    padding: 0 20px;
  }

  .splash-video-wrap {
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    opacity: 0;
    transform: scale(0.985);
    animation: video-in 1s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
  }

  .splash-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* card：居中的圆角卡片 */
  .splash[data-fit='card'] .splash-video-wrap {
    width: min(calc(var(--video-scale, 0.82) * 100vw), 880px);
    /* 浅底视频加一点描边和阴影，让它"落"在页面上而不是浮着 */
    box-shadow: 0 20px 60px -30px rgba(15, 23, 42, 0.35),
      0 0 0 1px rgba(15, 23, 42, 0.06);
  }

  .splash[data-fit='card'] .splash-video {
    height: auto;
    max-height: 62vh;
    object-fit: contain;
  }

  /* cover / contain：整屏当背景板
     用 fixed 而不是 absolute —— absolute 会跟随父级尺寸/动画，某些情况下
     底部或两侧会漏出页面底色（就是那条白边）。fixed 直接贴着视口，绝对铺满。
     宽度/高度用 100vw/100vh 并叠加 JS 实测的 --vh，兼容移动端地址栏收起。 */
  .splash[data-fit='cover'] .splash-video-wrap,
  .splash[data-fit='contain'] .splash-video-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    height: var(--vh, 100vh);
    max-width: none;
    max-height: none;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    background: #000;
    animation: fade-only 0.9s ease 0.05s forwards;
  }

  /* 视频本身强制铺满，避免出现"白边" */
  .splash[data-fit='cover'] .splash-video,
  .splash[data-fit='contain'] .splash-video {
    display: block;
    width: 100vw;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
  }

  .splash[data-fit='contain'] .splash-video {
    object-fit: contain;
  }

  /* 遮罩：保证压在视频上的文字能看清，同时让边缘自然融进页面 */
  .splash-scrim {
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        120% 80% at 50% 62%,
        rgba(6, 8, 16, calc(var(--video-overlay, 0.32) * 0.75)) 0%,
        rgba(6, 8, 16, 0) 62%
      ),
      linear-gradient(
        180deg,
        rgba(6, 8, 16, calc(var(--video-overlay, 0.32) * 0.65)) 0%,
        rgba(6, 8, 16, 0) 26%,
        rgba(6, 8, 16, 0) 62%,
        rgba(6, 8, 16, calc(var(--video-overlay, 0.32) * 0.8)) 100%
      );
  }

  @keyframes video-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade-only {
    to {
      opacity: 1;
    }
  }

  .splash-caption {
    text-align: center;
  }

  /* 整屏背景板时，文字压在画面中下部（用 fixed 相对视口，避免被 flex 居中） */
  .splash[data-fit='cover'] .splash-caption,
  .splash[data-fit='contain'] .splash-caption {
    position: fixed;
    left: 0;
    right: 0;
    bottom: clamp(140px, 22vh, 220px);
    padding: 0 24px;
    z-index: 3;
  }

  /* ---------- 流式输出文案（SSE 那种一个字一个字蹦出来） ---------- */
  .splash-stream {
    margin: 0;
    font-size: clamp(1.5rem, 4.4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text);
    min-height: 1.35em;
  }

  .splash-stream-text {
    white-space: pre-wrap;
  }

  .stream-caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 4px;
    vertical-align: -0.16em;
    background: currentColor;
    animation: caret-blink 1s steps(2, start) infinite;
  }

  .splash.is-stream-done .stream-caret {
    animation: none;
    opacity: 0.25;
  }

  .splash[data-cursor='0'] .stream-caret {
    display: none;
  }

  .splash[data-variant='video'] .splash-name {
    margin: 0;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 550;
    letter-spacing: 0.14em;
    color: var(--text);
  }

  /* 背景板模式：文字反白，并加一点点投影 */
  .splash[data-fit='cover'] .splash-stream,
  .splash[data-fit='contain'] .splash-stream {
    color: #fff;
    text-shadow: 0 2px 20px rgba(6, 8, 16, 0.6), 0 1px 4px rgba(6, 8, 16, 0.4);
  }

  .splash[data-fit='cover'] .splash-name,
  .splash[data-fit='contain'] .splash-name {
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff;
    text-shadow: 0 2px 18px rgba(6, 8, 16, 0.55);
  }

  .splash[data-fit='cover'] .splash-sub,
  .splash[data-fit='contain'] .splash-sub {
    color: rgba(255, 255, 255, 0.86);
    text-shadow: 0 1px 12px rgba(6, 8, 16, 0.6);
  }

  /* 背景板模式下，底部提示也要反白 */
  .splash[data-fit='cover'] .splash-enter,
  .splash[data-fit='contain'] .splash-enter {
    z-index: 2;
    color: rgba(255, 255, 255, 0.82);
  }

  .splash[data-fit='cover'] .splash-enter:hover,
  .splash[data-fit='contain'] .splash-enter:hover {
    color: #fff;
  }

  .splash[data-fit='cover'] .splash-bar,
  .splash[data-fit='contain'] .splash-bar {
    background: rgba(255, 255, 255, 0.3);
  }

  .splash[data-fit='cover'] .splash-bar i,
  .splash[data-fit='contain'] .splash-bar i {
    background: #fff;
  }

  /* ---- minimal：细字姓名 ---- */
  .splash[data-variant='minimal'] .splash-name {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.4rem);
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--text);
    opacity: 0;
    transform: translateY(8px);
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }

  /* ---- typewriter：打字机 ---- */
  .splash[data-variant='typewriter'] .splash-greet {
    margin: 0 0 12px;
    font-size: 0.92rem;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    font-family: var(--font-mono);
    min-height: 1.7em;
  }

  .caret {
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 3px;
    vertical-align: -0.14em;
    background: var(--text-soft);
    animation: caret-blink 1s steps(2, start) infinite;
  }

  .splash.is-typed .caret {
    opacity: 0.3;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .splash[data-variant='typewriter'] .splash-name {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3.2rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .splash-name .ch {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.35em);
    animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- 共用 ---- */
  .splash-sub {
    margin: 16px 0 0;
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .splash-sub.is-in {
    opacity: 1;
  }

  .splash-enter {
    position: absolute;
    bottom: clamp(32px, 9vh, 72px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: none;
    border: none;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.8s ease 0.3s, color 0.18s ease;
  }

  .splash-enter.is-in {
    opacity: 1;
  }

  .splash-enter:hover {
    color: var(--text);
  }

  .splash-arrow svg {
    display: block;
    animation: arrow-bob 2s ease-in-out infinite;
  }

  @keyframes arrow-bob {
    0%,
    100% {
      transform: translateY(-2px);
      opacity: 0.5;
    }
    50% {
      transform: translateY(3px);
      opacity: 1;
    }
  }

  .splash-bar {
    display: block;
    width: 96px;
    height: 1px;
    background: var(--border-strong);
    overflow: hidden;
  }

  .splash-bar i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--text);
    transition: width 0.16s ease-out;
  }
</style>

<script>
  type SplashEl = HTMLElement & { __splashCleanup?: () => void };

  function initSplash() {
    const el = document.getElementById('splash') as SplashEl | null;
    if (!el || el.dataset.ready === '1') return;
    el.dataset.ready = '1';

    const params = new URLSearchParams(location.search);
    const wantsReplay = params.get('intro') === '1';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const variant = el.dataset.variant || 'minimal';

    const seenKey = 'splash-seen';
    let seen = false;
    try {
      seen = sessionStorage.getItem(seenKey) === '1';
    } catch {
      seen = false;
    }

    const base = import.meta.env.BASE_URL;
    const isHome =
      location.pathname === '/' ||
      location.pathname === '/index.html' ||
      location.pathname === base ||
      location.pathname === `${base}index.html`;

    if (!wantsReplay && (seen || !isHome)) {
      el.classList.add('is-skipped');
      document.documentElement.dataset.splash = 'done';
      return;
    }

    const scrollY = window.scrollY;
    document.documentElement.classList.add('splash-lock');
    document.documentElement.style.overflow = 'hidden';
    document.documentElement.dataset.splash = 'active';
    if (!wantsReplay) window.scrollTo(0, 0);

    // 姓名逐字浮现（仅打字机模式保留）
    const nameEl = document.getElementById('splash-name');
    if (nameEl && variant === 'typewriter') {
      const chars = nameEl.textContent || '';
      nameEl.textContent = '';
      [...chars].forEach((ch, i) => {
        const span = document.createElement('span');
        span.className = 'ch';
        span.textContent = ch === ' ' ? '\u00a0' : ch;
        span.style.setProperty('--d', `${300 + i * 80}ms`);
        nameEl.appendChild(span);
      });
    }

    // 全屏背景板：用 JS 实测视口高度写进 --vh，避免移动端地址栏导致的缝隙
    // 注意：这里只能用 DOM 上的 data-fit，模板里的常量在客户端脚本里不存在
    const fit = el.dataset.fit;
    if (fit === 'cover' || fit === 'contain') {
      const syncVh = () => {
        document.documentElement.style.setProperty('--vh', `${window.innerHeight}px`);
      };
      syncVh();
      window.addEventListener('resize', syncVh, { passive: true });
      window.addEventListener('orientationchange', syncVh, { passive: true });
    }

    // 视频模式：手动触发播放，兼容少数不会自动播放的场景
    const videoEl = document.getElementById('splash-video') as HTMLVideoElement | null;
    if (videoEl) {
      videoEl.muted = true;
      const tryPlay = () => {
        const p = videoEl.play();
        if (p && typeof p.catch === 'function') {
          p.catch(() => {
            // 被浏览器拦下时，等用户第一次操作再播
            const resume = () => {
              videoEl.play().catch(() => {});
              window.removeEventListener('pointerdown', resume);
              window.removeEventListener('keydown', resume);
            };
            window.addEventListener('pointerdown', resume, { once: true });
            window.addEventListener('keydown', resume, { once: true });
          });
        }
      };
      if (videoEl.readyState >= 2) tryPlay();
      else videoEl.addEventListener('loadeddata', tryPlay, { once: true });
    }

    /* ---------- 流式输出：像 SSE 一样一个字一个字吐出来 ---------- */
    const streamText = el.dataset.stream || '';
    const speed = Number(el.dataset.speed || 150);
    const streamTextEl = document.getElementById('splash-stream-text');
    let streamTimer: number | undefined;

    const streamDone = () => {
      el.classList.add('is-stream-done');
    };

    if (streamTextEl) {
      if (reduced || !streamText) {
        streamTextEl.textContent = streamText;
        streamDone();
      } else {
        let i = 0;
        const tick = () => {
          i += 1;
          streamTextEl.textContent = streamText.slice(0, i);
          if (i < streamText.length) {
            streamTimer = window.setTimeout(tick, speed);
          } else {
            streamDone();
          }
        };
        streamTimer = window.setTimeout(tick, 260);
      }
    }

    // 打字机模式的问候语（老变体保留）
    const typedEl = document.getElementById('splash-typed');
    const shouldType = variant === 'typewriter' && !reduced && Boolean(typedEl);
    let typeTimer: number | undefined;

    if (shouldType && typedEl) {
      const greeting = el.dataset.greeting || '';
      let i = 0;
      const tick = () => {
        typedEl.textContent = greeting.slice(0, i);
        i += 1;
        if (i <= greeting.length) {
          typeTimer = window.setTimeout(tick, 130);
        } else {
          el.classList.add('is-typed');
        }
      };
      typeTimer = window.setTimeout(tick, 200);
    }

    const subEl = document.getElementById('splash-sub');
    if (subEl) {
      subEl.textContent = el.dataset.sub || '';
      window.setTimeout(() => subEl.classList.add('is-in'), reduced ? 0 : 1100);
    }

    const enterBtn = document.getElementById('splash-enter') as HTMLButtonElement | null;
    window.setTimeout(() => enterBtn?.classList.add('is-in'), reduced ? 0 : 1400);

    // video / minimal 立刻可进；typewriter 等打完字
    const typeDuration = shouldType ? 200 + (el.dataset.greeting?.length ?? 0) * 130 : 0;
    let done = reduced || variant === 'video' || variant === 'minimal';
    const unlock = window.setTimeout(() => {
      done = true;
    }, typeDuration + 900);

    // 视频作为背景动画可以一直循环，用户随时可以进主页
    const progress = document.getElementById('splash-progress') as HTMLElement | null;
    let leaving = false;
    let acc = 0;
    const THRESHOLD = variant === 'video' ? 120 : 200;

    const cleanup = () => {
      window.clearTimeout(typeTimer);
      window.clearTimeout(streamTimer);
      window.clearTimeout(unlock);
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('touchstart', onTouchStart);
      window.removeEventListener('touchmove', onTouchMove);
      window.removeEventListener('keydown', onKey);
      el.removeEventListener('click', onClick);
      enterBtn?.removeEventListener('click', onClickBtn);
    };

    const enter = () => {
      if (leaving) return;
      leaving = true;
      try {
        sessionStorage.setItem(seenKey, '1');
      } catch {
        /* 隐私模式忽略 */
      }

      el.classList.add('is-leaving');
      document.documentElement.dataset.splash = 'done';
      document.documentElement.style.overflow = '';
      document.documentElement.classList.remove('splash-lock');
      window.scrollTo(0, wantsReplay ? scrollY : 0);

      window.setTimeout(() => el.remove(), 700);
      window.dispatchEvent(new CustomEvent('splash:enter'));
      cleanup();
    };

    const unblock = () => {
      if (!done) {
        done = true;
        window.clearTimeout(unlock);
      }
    };

    const push = (delta: number) => {
      acc = Math.max(0, Math.min(THRESHOLD, acc + delta));
      if (progress) progress.style.width = `${(acc / THRESHOLD) * 100}%`;
      if (acc >= THRESHOLD) enter();
    };

    const onWheel = (e: WheelEvent) => {
      e.preventDefault();
      unblock();
      push(e.deltaY);
    };

    let touchStartY = 0;
    const onTouchStart = (e: TouchEvent) => {
      touchStartY = e.touches[0]?.clientY ?? 0;
    };
    const onTouchMove = (e: TouchEvent) => {
      e.preventDefault();
      unblock();
      const y = e.touches[0]?.clientY ?? touchStartY;
      push(touchStartY - y);
    };

    const onKey = (e: KeyboardEvent) => {
      if (['ArrowDown', 'PageDown', ' ', 'Enter'].includes(e.key)) {
        e.preventDefault();
        unblock();
        push(THRESHOLD);
      }
    };

    const onClick = (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('#splash-enter')) return;
      unblock();
      push(THRESHOLD);
    };

    const onClickBtn = (e: MouseEvent) => {
      e.stopPropagation();
      unblock();
      push(THRESHOLD);
    };

    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('touchstart', onTouchStart, { passive: true });
    window.addEventListener('touchmove', onTouchMove, { passive: false });
    window.addEventListener('keydown', onKey);
    el.addEventListener('click', onClick);
    enterBtn?.addEventListener('click', onClickBtn);

    el.__splashCleanup = cleanup;

    document.addEventListener(
      'astro:before-swap',
      () => {
        cleanup();
        document.documentElement.style.overflow = '';
        document.documentElement.classList.remove('splash-lock');
      },
      { once: true }
    );
  }

  initSplash();
  document.addEventListener('astro:after-swap', initSplash);
  document.addEventListener('astro:page-load', initSplash);
</script>
